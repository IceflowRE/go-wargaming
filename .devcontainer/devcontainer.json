{
  "name": "Go WG",
  "image": "mcr.microsoft.com/devcontainers/go:1-1.24-bookworm",
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "customizations": {
    "vscode": {
      "settings": {},
      "extensions": [
        "golang.go",
        "streetsidesoftware.code-spell-checker"
      ]
    }
  },
  "postCreateCommand": {
    "install golangci-lint": "curl -sSfL https://raw.githubusercontent.com/golangci/golangci-lint/HEAD/install.sh | sh -s -- -b $(go env GOPATH)/bin"
  }
}