{
    "go.lintTool": "golangci-lint",
    "go.lintFlags": [
        "--path-mode=abs",
        //"--fast-only"
    ],
    "go.formatTool": "custom",
    "go.alternateTools": {
        "customFormatter": "golangci-lint"
    },
    "go.formatFlags": [
        "fmt",
        "--stdin"
    ],
    "gopls": {
        "formatting.local": "github.com/IceflowRE/go-wargaming",
        "formatting.gofumpt": true,
    }
}